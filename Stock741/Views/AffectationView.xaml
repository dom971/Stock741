<UserControl x:Class="Stock741.Views.AffectationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10"
          Cursor="{Binding IsBusy, Converter={StaticResource BoolToCursorConverter}}"
          ForceCursor="{Binding IsBusy}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="Affecter"
                    Command="{Binding AjouterCommand}"
                    IsEnabled="{Binding PeutAjouter}"
                    Visibility="{Binding PeutAjouter, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,5,0"/>
            <Button Content="Modifier" Command="{Binding ModifierCommand}" Margin="5,0,0,0"/>
            <Button Content="Nouveau" Command="{Binding NouveauCommand}" Margin="15,0,0,0"/>
            <Button Content="Actualiser" Command="{Binding ActualiserCommand}" Margin="5,0,0,0"/>
            <Label Content="Recherche affectations:" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox Width="220"
                     Text="{Binding Filtre, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,5,0"/>
            <CheckBox Content="Voir historique"
                      IsChecked="{Binding AfficherHistorique}"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="#9AC6A8"
                    BorderThickness="0,1,0,1"
                    Background="#EAF5EE"
                    Margin="0,0,0,6"
                    Padding="6">
                <TextBlock Text="Choix du mat&#233;riel" Foreground="#00643E" FontWeight="Bold"/>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Recherche mat&#233;riel:"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FiltreMateriel, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,15,2"/>

                <Label Grid.Column="2" Content="Mat&#233;riel:"/>
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding StocksDisponibles}"
                          SelectedItem="{Binding StockSelectionne}"
                          IsEnabled="{Binding PeutChoisirMateriel}"
                          Margin="0,2,0,2"
                          IsTextSearchEnabled="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Asset}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding Modele.Marque.Nom}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding Modele.Nom}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding NumSerie}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Border Margin="0,0,0,8"
                    Padding="8"
                    Background="#F9F9F9"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Visibility="{Binding StockSelectionne, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Image DockPanel.Dock="Left"
                           Width="120"
                           Height="90"
                           Margin="0,0,14,0"
                           Stretch="Uniform"
                           Source="{Binding StockSelectionne.Modele.CheminPhoto, Converter={StaticResource NomFichierToImageConverter}}"/>

                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Asset: " Foreground="#00643E" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockSelectionne.Asset}" Margin="0,0,16,0"/>
                        <TextBlock Text="N&#176; s&#233;rie: " Foreground="#00643E" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockSelectionne.NumSerie}" Margin="0,0,16,0"/>
                        <TextBlock Text="Mat&#233;riel: " Foreground="#00643E" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockSelectionne.Modele.Materiel.Nom}"/>
                        <TextBlock Text=" / "/>
                        <TextBlock Text="{Binding StockSelectionne.Modele.Marque.Nom}"/>
                        <TextBlock Text=" / "/>
                        <TextBlock Text="{Binding StockSelectionne.Modele.Nom}" Margin="0,0,16,0"/>
                        <TextBlock Text="Statut: " Foreground="#00643E" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockSelectionne.Statut.Nom}" Margin="0,0,16,0"/>
                        <TextBlock Text="Lieu: " Foreground="#00643E" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StockSelectionne.Lieu.Nom}"/>
                    </WrapPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border BorderBrush="#9AC6A8"
                    BorderThickness="0,1,0,1"
                    Background="#EAF5EE"
                    Margin="0,0,0,6"
                    Padding="6">
                <TextBlock Text="Affectation" Foreground="#00643E" FontWeight="Bold"/>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Date affectation:"/>
                <DatePicker Grid.Row="0" Grid.Column="1"
                            SelectedDate="{Binding DateDebut}"
                            Margin="0,2,15,2"/>

                <Label Grid.Row="0" Grid.Column="2" Content="Date de pr&#234;t:"/>
                <DatePicker Grid.Row="0" Grid.Column="3"
                            SelectedDate="{Binding DatePret}"
                            Margin="0,2,15,2"/>

                <Label Grid.Row="0" Grid.Column="4" Content="Statut:"/>
                <ComboBox Grid.Row="0" Grid.Column="5"
                          ItemsSource="{Binding StatutsAffectation}"
                          SelectedItem="{Binding StatutAffectationSelectionne}"
                          DisplayMemberPath="Nom"
                          Margin="0,2,0,2"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Recherche utilisateur:"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Text="{Binding FiltreUtilisateur, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,15,2"/>

                <Label Grid.Row="1" Grid.Column="4" Content="Recherche EDS:"/>
                <TextBox Grid.Row="1" Grid.Column="5"
                         Text="{Binding FiltreEds, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,2"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           Text="Saisir au moins 2 caractères pour lancer la recherche utilisateur ou EDS."
                           Foreground="#777777"
                           FontSize="11"
                           Margin="0,0,0,4"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Utilisateur:"/>
                <ComboBox Grid.Row="3" Grid.Column="1"
                          Grid.ColumnSpan="3"
                          ItemsSource="{Binding Utilisateurs}"
                          SelectedItem="{Binding UtilisateurSelectionne}"
                          Margin="0,2,15,2"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Nom">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Nom}"/>
                                <TextBlock Text=" "/>
                                <TextBlock Text="{Binding Prenom}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding IdWindows}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Label Grid.Row="3" Grid.Column="4" Content="EDS:"/>
                <ComboBox Grid.Row="3" Grid.Column="5"
                          ItemsSource="{Binding EdsListe}"
                          SelectedItem="{Binding EdsSelectionne}"
                          Margin="0,2,0,2"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="Nom">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Cnx}"/>
                                <TextBlock Text=" - "/>
                                <TextBlock Text="{Binding Nom}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           Text="{Binding MessageEdsAutomatique}"
                           Foreground="#00643E"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,2,0,0"
                           Visibility="{Binding MessageEdsAutomatique, Converter={StaticResource StringToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding AfficherTelephonie, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border BorderBrush="#9AC6A8"
                        BorderThickness="0,1,0,1"
                        Background="#EAF5EE"
                        Margin="0,0,0,6"
                        Padding="6">
                    <TextBlock Text="T&#233;l&#233;phonie" Foreground="#00643E" FontWeight="Bold"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Op&#233;rateur:"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Operateurs}"
                              SelectedItem="{Binding OperateurSelectionne}"
                              DisplayMemberPath="Nom"
                              Margin="0,2,15,2"/>

                    <Label Grid.Column="2" Content="Forfait:"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding Forfaits}"
                              SelectedItem="{Binding ForfaitSelectionne}"
                              DisplayMemberPath="Nom"
                              Margin="0,2,15,2"/>

                    <Label Grid.Column="4" Content="N&#176; mobile:"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding NumTelMobile, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="20"
                             Margin="0,2,0,2"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding AfficherPoste, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border BorderBrush="#9AC6A8"
                        BorderThickness="0,1,0,1"
                        Background="#EAF5EE"
                        Margin="0,0,0,6"
                        Padding="6">
                    <TextBlock Text="Poste" Foreground="#00643E" FontWeight="Bold"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Nom PC:"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding NomPC, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             Margin="0,2,15,2"/>

                    <Label Grid.Row="0" Grid.Column="2" Content="EDS PC:"/>
                    <TextBox Grid.Row="0" Grid.Column="3"
                             Text="{Binding EdsPC, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="3"
                             Margin="0,2,15,2"/>

                    <Label Grid.Row="0" Grid.Column="4" Content="Ancien PC:"/>
                    <TextBox Grid.Row="0" Grid.Column="5"
                             Text="{Binding AncienPC, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="12"
                             Margin="0,2,0,2"/>
                </Grid>
            </StackPanel>

            <StackPanel Visibility="{Binding AfficherReseau, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border BorderBrush="#9AC6A8"
                        BorderThickness="0,1,0,1"
                        Background="#EAF5EE"
                        Margin="0,0,0,6"
                        Padding="6">
                    <TextBlock Text="R&#233;seau" Foreground="#00643E" FontWeight="Bold"/>
                </Border>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Appareil:"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Grid.ColumnSpan="5"
                             Text="{Binding NomAppareil, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100"
                             Margin="0,2,0,2"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Adresse IP:"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding AdresseIP, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Margin="0,2,15,2"/>

                    <Label Grid.Row="1" Grid.Column="2" Content="Masque:"/>
                    <TextBox Grid.Row="1" Grid.Column="3"
                             Text="{Binding MasqueIP, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Margin="0,2,15,2"/>

                    <Label Grid.Row="1" Grid.Column="4" Content="Passerelle:"/>
                    <TextBox Grid.Row="1" Grid.Column="5"
                             Text="{Binding PasserelleIP, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             Margin="0,2,0,2"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Border BorderBrush="#9AC6A8"
                    BorderThickness="0,1,0,1"
                    Background="#EAF5EE"
                    Margin="0,0,0,6"
                    Padding="6">
                <TextBlock Text="Suivi" Foreground="#00643E" FontWeight="Bold"/>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Motif:"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Motif, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,15,2"/>

                <Label Grid.Column="2" Content="Commentaire:"/>
                <TextBox Grid.Column="3"
                         Text="{Binding Commentaire, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,2,0,2"/>
            </Grid>

            <StackPanel Margin="0,4,0,8"
                        Visibility="{Binding PeutRetourner, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border BorderBrush="#9AC6A8"
                        BorderThickness="0,1,0,1"
                        Background="#EAF5EE"
                        Margin="0,0,0,6"
                        Padding="6">
                    <TextBlock Text="Retour en stock" Foreground="#00643E" FontWeight="Bold"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Date mouvement:"/>
                    <DatePicker Grid.Column="1"
                                SelectedDate="{Binding DateMouvement}"
                                Margin="0,2,15,2"/>

                    <Label Grid.Column="2" Content="Statut retour:"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding StatutsRetour}"
                              SelectedItem="{Binding StatutRetourSelectionne}"
                              DisplayMemberPath="Nom"
                              Margin="0,2,15,2"/>

                    <Label Grid.Column="4" Content="Motif:"/>
                    <TextBox Grid.Column="5"
                             Text="{Binding MotifRetour, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,15,2"/>

                    <Label Grid.Column="6" Content="Commentaire:"/>
                    <TextBox Grid.Column="7"
                             Text="{Binding CommentaireRetour, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,15,2"/>

                    <Button Grid.Column="8"
                            Content="Valider retour"
                            Command="{Binding RetournerCommand}"
                            IsEnabled="{Binding PeutRetourner}"
                            Margin="0,2,0,2"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="5"
                   Text="{Binding MessageSucces}"
                   Foreground="Green"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"
                   Visibility="{Binding MessageSucces, Converter={StaticResource StringToVisibilityConverter}}"/>

        <TextBlock Grid.Row="5"
                   Text="{Binding ErreurGlobale}"
                   Foreground="Red"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5"
                   Visibility="{Binding ErreurGlobale, Converter={StaticResource StringToVisibilityConverter}}"/>

        <DataGrid Grid.Row="5"
                  ItemsSource="{Binding Affectations}"
                  SelectedItem="{Binding AffectationSelectionnee}"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Asset" Binding="{Binding Stock.Asset}" Width="Auto"/>
                <DataGridTextColumn Header="Date d&#233;but" Binding="{Binding DateDebut, StringFormat={}{0:dd/MM/yyyy}}" Width="Auto"/>
                <DataGridTextColumn Header="Mat&#233;riel" Binding="{Binding Stock.Modele.Materiel.Nom}" Width="Auto"/>
                <DataGridTextColumn Header="Marque" Binding="{Binding Stock.Modele.Marque.Nom}" Width="Auto"/>
                <DataGridTextColumn Header="Mod&#232;le" Binding="{Binding Stock.Modele.Nom}" Width="*"/>
                <DataGridTextColumn Header="N&#176; S&#233;rie" Binding="{Binding Stock.NumSerie}" Width="Auto"/>
                <DataGridTextColumn Header="Utilisateur" Binding="{Binding Utilisateur.NomComplet}" Width="*"/>
                <DataGridTextColumn Header="EDS auto" Binding="{Binding EdsAutomatique.Cnx}" Width="Auto"/>
                <DataGridTextColumn Header="EDS" Binding="{Binding Eds.Cnx}" Width="Auto"/>
                <DataGridCheckBoxColumn Header="Actif" Binding="{Binding Actif}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="6"
                Margin="0,8,0,0"
                Padding="10"
                Background="#F9F9F9"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                Visibility="{Binding Detail, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Mat&#233;riel" Foreground="#00643E" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="Asset" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Stock.Asset}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="Mod&#232;le" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Stock.Modele.Nom}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="N&#176; s&#233;rie" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Stock.NumSerie}" FontSize="12" Foreground="#535353"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="Affect&#233; &#224;" Foreground="#00643E" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="Utilisateur" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Utilisateur.NomComplet}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="ID Windows" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Utilisateur.IdWindows}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="EDS" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Eds.Nom}" FontSize="12" Foreground="#535353"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="D&#233;tail" Foreground="#00643E" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                    <TextBlock Text="P&#233;riode" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Detail.DateDebut, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#535353"/>
                        <TextBlock Text=" -> " FontSize="12" Foreground="#535353"/>
                        <TextBlock Text="{Binding Detail.DateFin, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#535353"/>
                    </StackPanel>
                    <TextBlock Text="Dernier mouvement" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.DateMouvement, StringFormat={}{0:dd/MM/yyyy}}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="T&#233;l&#233;phonie" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.NumTelMobile}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="R&#233;seau" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.AdresseIP}" FontSize="12" Foreground="#535353"/>
                    <TextBlock Text="{Binding Detail.NomPC}" FontSize="12" Foreground="#535353" Margin="0,0,0,4"/>
                    <TextBlock Text="Commentaire" Foreground="#00643E" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Detail.Commentaire}" TextWrapping="Wrap" FontSize="12" Foreground="#535353"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
